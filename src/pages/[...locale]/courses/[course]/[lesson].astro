---
import { getCollection, render } from 'astro:content';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { coursePath, homePath, lessonPath } from '../../../../lib/content';
import { locales, localeParam, otherLocale, t, type Locale } from '../../../../lib/i18n';
import {
  getCourseLessons,
  localizeCourse,
  localizeLesson,
  type LocalizedCourse,
  type LocalizedLesson,
} from '../../../../lib/localized-content';

export async function getStaticPaths() {
  const [courses, lessons] = await Promise.all([getCollection('courses'), getCollection('lessons')]);
  return Promise.all(locales.flatMap((locale) => lessons.map(async (lesson) => {
    const [course, lessonSlug] = lesson.id.split('/');
    const parent = courses.find((entry) => entry.id === course);
    if (!course || !lessonSlug || !parent) throw new Error(`Lesson ${lesson.id} has no matching course`);
    return {
      params: { locale: localeParam(locale), course, lesson: lessonSlug },
      props: {
        locale,
        lesson: await localizeLesson(lesson, locale),
        course: await localizeCourse(parent, locale),
      },
    };
  })));
}

interface Props {
  locale: Locale;
  lesson: LocalizedLesson;
  course: LocalizedCourse;
}

const { locale, lesson, course } = Astro.props;
const messages = t(locale);
const base = import.meta.env.BASE_URL;
const { Content } = await render(lesson.entry);
const courseLessons = await getCourseLessons(course.source, locale);
const currentIndex = courseLessons.findIndex((entry) => entry.id === lesson.id);
if (currentIndex === -1) throw new Error(`Lesson ${lesson.id} is not listed by course ${course.id}`);
const previousLesson = courseLessons[currentIndex - 1];
const nextLesson = courseLessons[currentIndex + 1];
const parentUrl = coursePath(base, course.id, locale);
const alternateUrl = lessonPath(base, lesson.id, otherLocale(locale));
---

<BaseLayout locale={locale} alternateUrl={alternateUrl} title={lesson.title} description={lesson.description}>
  <div class="content-page">
    <Breadcrumbs label={messages.breadcrumb} items={[
      { label: messages.home, href: homePath(base, locale) },
      { label: course.title, href: parentUrl },
      { label: lesson.title },
    ]} />
    <div class="page-shell lesson-page">
      <header class="page-heading lesson-heading">
        <p class="eyebrow">{course.title} · {messages.lessonPosition(currentIndex + 1, courseLessons.length)}</p>
        <h1>{lesson.title}</h1>
        <p>{lesson.description}</p>
      </header>
      <article class="prose lesson-prose"><Content /></article>
      <nav class="lesson-navigation" aria-label={messages.lessonNavigation}>
        {previousLesson ? (
          <a class="previous" href={lessonPath(base, previousLesson.id, locale)}>
            <small>{messages.previousLesson}</small><strong>← {previousLesson.title}</strong>
          </a>
        ) : null}
        {nextLesson ? (
          <a class="next" href={lessonPath(base, nextLesson.id, locale)}>
            <small>{messages.nextLesson}</small><strong>{nextLesson.title} →</strong>
          </a>
        ) : (
          <a class="next" href={parentUrl}><small>{messages.courseComplete}</small><strong>{messages.backToCourse(course.title)} →</strong></a>
        )}
      </nav>
    </div>
  </div>
</BaseLayout>
