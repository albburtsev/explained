---
import { getCollection } from 'astro:content';
import CourseCard from '../components/CourseCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const courses = (await getCollection('courses')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout>
  <div class="home-page page-shell">
    <section class="course-catalog" aria-labelledby="courses-heading">
      <h1 id="courses-heading" class="sr-only">Courses</h1>
      <div class="course-list">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </section>
  </div>
</BaseLayout>
