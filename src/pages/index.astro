---
import { getCollection } from 'astro:content';
import CourseCard from '../components/CourseCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const courses = (await getCollection('courses')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const coursesUrl = `${import.meta.env.BASE_URL}courses/`;
---

<BaseLayout>
  <section class="hero page-shell">
    <p class="eyebrow">Learn. Keep. Revisit.</p>
    <h1>Knowledge, carefully explained.</h1>
    <p class="hero-copy">A personal collection of practical courses and concise lessons, written in Markdown and designed to stay useful.</p>
    <div class="hero-actions">
      <a class="button" href={coursesUrl}>Explore courses</a>
      <span>{courses.length} {courses.length === 1 ? 'course' : 'courses'} available</span>
    </div>
  </section>
  <section class="page-shell section-block" aria-labelledby="featured-courses">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Start learning</p>
        <h2 id="featured-courses">Featured courses</h2>
      </div>
      <a href={coursesUrl}>View all →</a>
    </div>
    <div class="course-grid">
      {courses.map((course) => <CourseCard course={course} />)}
    </div>
  </section>
</BaseLayout>
