---
import { coursePath } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import type { LocalizedCourse } from '../lib/localized-content';

interface Props {
  course: LocalizedCourse;
  locale: Locale;
}

const { course, locale } = Astro.props;
const messages = t(locale);
const href = coursePath(import.meta.env.BASE_URL, course.id, locale);
---

<article class="course-entry">
  <div class="course-entry-copy">
    <h2><a href={href}>{course.title}</a></h2>
    <p>{course.description}</p>
  </div>
  <div class="course-entry-meta">{messages.lessonCount(course.lessonCount)}</div>
  <div class="tag-list" aria-label={messages.topics}>
    {course.tags.map((tag) => <span>{tag}</span>)}
  </div>
</article>
