---
import { searchIndexPath } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = t(locale);
---

<div class="search" data-search-root data-search-index={searchIndexPath(import.meta.env.BASE_URL, locale)}>
  <label class="sr-only" for="site-search">{messages.searchLabel}</label>
  <div class="search-control">
    <input
      id="site-search"
      type="search"
      placeholder={messages.searchPlaceholder}
      autocomplete="off"
      aria-autocomplete="list"
      aria-controls="search-results"
      aria-expanded="false"
      data-search-input
    />
    <kbd>⌘K</kbd>
  </div>
  <div class="search-panel" data-search-panel hidden>
    <p class="search-status" data-search-status>{messages.searchStart}</p>
    <ul id="search-results" class="search-results" role="listbox" data-search-results></ul>
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';
  import { documentLocale, t } from '../lib/i18n';
  import { createSearch, type SearchDocument } from '../lib/search';

  type SearchEngine = ReturnType<typeof createSearch>;

  // Page swaps replace the header, so these point at the current page's elements.
  let messages = t(documentLocale());
  let root: HTMLElement | null = null;
  let input: HTMLInputElement | null | undefined;
  let panel: HTMLElement | null | undefined;
  let status: HTMLElement | null | undefined;
  let results: HTMLUListElement | null | undefined;

  // Each locale has its own index; keep loaded ones for switching back.
  const engines = new Map<string, Promise<SearchEngine | undefined>>();
  let engine: SearchEngine | undefined;
  let selectedIndex = -1;
  let currentDocuments: SearchDocument[] = [];

  const openPanel = () => {
    if (!input || !panel) return;
    panel.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  };

  const closePanel = () => {
    if (!input || !panel) return;
    panel.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
    selectedIndex = -1;
  };

  const renderResults = () => {
    if (!input || !results || !status) return;
    const query = input.value.trim();
    results.replaceChildren();
    selectedIndex = -1;

    if (query.length < 2) {
      currentDocuments = [];
      status.textContent = query.length === 0 ? messages.searchStart : messages.searchTooShort;
      status.hidden = false;
      return;
    }

    currentDocuments = (engine?.search(query, { limit: 8 }) ?? []).map(({ item }) => item);
    if (currentDocuments.length === 0) {
      status.textContent = messages.searchNoResults(query);
      status.hidden = false;
      return;
    }

    status.hidden = true;
    for (const [index, searchDocument] of currentDocuments.entries()) {
      const item = document.createElement('li');
      item.id = `search-result-${index}`;
      item.role = 'option';
      item.setAttribute('aria-selected', 'false');
      const link = document.createElement('a');
      link.href = searchDocument.url;
      const kind = document.createElement('span');
      kind.className = 'search-result-kind';
      kind.textContent = messages.searchKind[searchDocument.kind];
      const title = document.createElement('strong');
      title.textContent = searchDocument.title;
      const context = document.createElement('small');
      context.textContent = searchDocument.context ?? searchDocument.description;
      link.append(kind, title, context);
      item.append(link);
      item.addEventListener('mousemove', () => selectResult(index));
      results.append(item);
    }
  };

  const loadIndex = async () => {
    if (engine) return;
    const indexUrl = root?.dataset.searchIndex;
    if (!indexUrl) return;

    let loading = engines.get(indexUrl);
    if (!loading) {
      if (status) status.textContent = messages.searchLoading;
      loading = fetch(indexUrl)
        .then((response) => {
          if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
          return response.json() as Promise<SearchDocument[]>;
        })
        .then(createSearch)
        .catch(() => {
          engines.delete(indexUrl);
          if (root?.dataset.searchIndex === indexUrl && status) status.textContent = messages.searchUnavailable;
          return undefined;
        });
      engines.set(indexUrl, loading);
    }

    const loaded = await loading;
    // Ignore an index that finished loading after the page switched locale.
    if (root?.dataset.searchIndex === indexUrl) engine = loaded;
  };

  const selectResult = (index: number) => {
    if (!input || !results || currentDocuments.length === 0) return;
    selectedIndex = (index + currentDocuments.length) % currentDocuments.length;
    for (const [itemIndex, item] of [...results.children].entries()) {
      item.setAttribute('aria-selected', String(itemIndex === selectedIndex));
    }
    input.setAttribute('aria-activedescendant', `search-result-${selectedIndex}`);
  };

  const initSearch = () => {
    messages = t(documentLocale());
    root = document.querySelector<HTMLElement>('[data-search-root]');
    input = root?.querySelector<HTMLInputElement>('[data-search-input]');
    panel = root?.querySelector<HTMLElement>('[data-search-panel]');
    status = root?.querySelector<HTMLElement>('[data-search-status]');
    results = root?.querySelector<HTMLUListElement>('[data-search-results]');
    engine = undefined;
    selectedIndex = -1;
    currentDocuments = [];
    if (!input) return;

    input.addEventListener('focus', () => {
      openPanel();
      void loadIndex().then(renderResults);
    });

    input.addEventListener('input', () => {
      openPanel();
      void loadIndex().then(renderResults);
    });

    input.addEventListener('keydown', handleInputKeydown);
  };

  const handleInputKeydown = (event: KeyboardEvent) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      selectResult(selectedIndex < 0 ? 0 : selectedIndex + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      selectResult(selectedIndex < 0 ? currentDocuments.length - 1 : selectedIndex - 1);
    } else if (event.key === 'Enter' && selectedIndex >= 0) {
      event.preventDefault();
      const selected = currentDocuments[selectedIndex];
      if (selected) void navigate(selected.url);
    } else if (event.key === 'Escape') {
      closePanel();
      input?.blur();
    }
  };

  document.addEventListener('astro:page-load', initSearch);

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      input?.focus();
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (root && event.target instanceof Node && !root.contains(event.target)) closePanel();
  });
</script>
