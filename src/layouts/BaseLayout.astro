---
import Search from '../components/Search.astro';
import { homePath } from '../lib/content';
import { locales, otherLocale, t, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  /** The same page in the other locale. */
  alternateUrl: string;
  title?: string;
  description?: string;
}

const { locale, alternateUrl, title } = Astro.props;
const messages = t(locale);
const alternateLocale = otherLocale(locale);
const alternateMessages = t(alternateLocale);
const description = Astro.props.description ?? messages.siteDescription;
const pageTitle = title ? `${title} · Explained` : `Explained · ${messages.siteTagline}`;
const homeUrl = homePath(import.meta.env.BASE_URL, locale);
// Every label a header toggle can show in any locale. They share one grid cell,
// so the widest one fixes the control width and switching never shifts the header.
const allMessages = locales.map(t);
const languageSizers = allMessages.map((entry) => entry.languageLabel);
const themeSizers = allMessages.flatMap((entry) => [entry.lightTheme, entry.darkTheme]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          if (localStorage.getItem('explained-theme') === 'light') theme = 'light';
        } catch {}

        if (theme === 'light') document.documentElement.dataset.theme = 'light';
        else delete document.documentElement.dataset.theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="alternate" hreflang={alternateLocale} href={alternateUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{messages.skipToContent}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={homeUrl} aria-label={messages.homeLabel}>
          <span class="wordmark-mark" aria-hidden="true">E</span>
          <span>Explained</span>
        </a>
        <Search locale={locale} />
        <div class="header-controls">
          <a
            class="locale-toggle"
            href={alternateUrl}
            hreflang={alternateLocale}
            lang={alternateLocale}
            aria-label={alternateMessages.switchLanguage}
          >
            <span>{alternateMessages.languageLabel}</span>
            {languageSizers.map((label) => <span class="toggle-sizer" aria-hidden="true">{label}</span>)}
          </a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label={messages.switchToLightTheme}>
            <span data-theme-label="light">{messages.lightTheme}</span>
            <span data-theme-label="dark">{messages.darkTheme}</span>
            {themeSizers.map((label) => <span class="toggle-sizer" aria-hidden="true">{label}</span>)}
          </button>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <a href="https://github.com/albburtsev/explained">{messages.viewSource}</a>
    </footer>
    <script>
      import { documentLocale, t } from '../lib/i18n';

      const messages = t(documentLocale());
      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

      const activeTheme = () => document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const syncThemeToggle = () => {
        if (!themeToggle) return;
        const nextTheme = activeTheme() === 'light' ? 'dark' : 'light';
        themeToggle.setAttribute(
          'aria-label',
          nextTheme === 'light' ? messages.switchToLightTheme : messages.switchToDarkTheme,
        );
      };

      themeToggle?.addEventListener('click', () => {
        const nextTheme = activeTheme() === 'light' ? 'dark' : 'light';
        if (nextTheme === 'light') document.documentElement.dataset.theme = 'light';
        else delete document.documentElement.dataset.theme;
        document.documentElement.style.colorScheme = nextTheme;
        try {
          localStorage.setItem('explained-theme', nextTheme);
        } catch {}
        syncThemeToggle();
      });

      syncThemeToggle();

      const fallbackCopyText = (text: string) => {
        const textarea = document.createElement('textarea');
        const activeElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        textarea.value = text;
        textarea.readOnly = true;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();

        let copied = false;
        try {
          copied = document.execCommand('copy');
        } catch {
          copied = false;
        } finally {
          textarea.remove();
          activeElement?.focus();
        }
        return copied;
      };

      const copyText = async (text: string) => {
        if (navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {}
        }

        return fallbackCopyText(text);
      };

      document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-block')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.before(wrapper);
        wrapper.append(pre);

        const button = document.createElement('button');
        button.className = 'code-copy-button';
        button.type = 'button';
        button.title = messages.copyCode;
        button.innerHTML = `
          <svg class="code-copy-icon" aria-hidden="true" viewBox="0 0 24 24">
            <rect x="8" y="8" width="13" height="13" rx="2"></rect>
            <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path>
          </svg>
          <svg class="code-copy-success-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="m5 12 4 4L19 6"></path>
          </svg>
          <span class="sr-only" data-copy-status aria-live="polite"></span>
        `;
        const initialStatus = button.querySelector<HTMLElement>('[data-copy-status]');
        if (initialStatus) initialStatus.textContent = messages.copyCode;
        wrapper.append(button);

        let resetTimer: number | undefined;
        button.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const copied = await copyText(code?.textContent ?? pre.textContent ?? '');
          const status = button.querySelector<HTMLElement>('[data-copy-status]');
          const message = copied ? messages.copied : messages.copyFailed;

          button.dataset.state = copied ? 'copied' : 'failed';
          button.title = message;
          if (status) status.textContent = message;

          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            delete button.dataset.state;
            button.title = messages.copyCode;
            if (status) status.textContent = messages.copyCode;
          }, 2000);
        });
      });
    </script>
  </body>
</html>
