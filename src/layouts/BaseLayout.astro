---
import Search from '../components/Search.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'A personal knowledge base built from structured Markdown.',
} = Astro.props;
const pageTitle = title ? `${title} · Explained` : 'Explained · A personal knowledge base';
const homeUrl = import.meta.env.BASE_URL;
const coursesUrl = `${import.meta.env.BASE_URL}courses/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href={homeUrl} aria-label="Explained home">
          <span class="wordmark-mark" aria-hidden="true">E</span>
          <span>Explained</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={coursesUrl}>Courses</a>
        </nav>
        <Search />
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <span>Built from Markdown with Astro.</span>
      <a href="https://github.com/albburtsev/explained">View source</a>
    </footer>
  </body>
</html>
